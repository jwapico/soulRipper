{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "no args",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
        {
            "name": "--playlist-url (long playlist)",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--playlist-url",
                // "https://open.spotify.com/playlist/6h9OgN50iDfClEDryizNe5?si=bd17141666794e3f",
                "https://open.spotify.com/playlist/1wybFX6hSdmwluPx2sbufs?si=7bb9211eea7c4d51"
            ]
        },
        {
            "name": "--playlist-url (short playlist)",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--playlist-url",
                // "https://open.spotify.com/playlist/47uFYjiMl6zRb0gZcy0Nas?si=41b5a57749e3482e",
                "https://open.spotify.com/playlist/5tPjgtonsvHqczRc8XR5cR?si=236108aedd6a49cf",
                // "https://open.spotify.com/playlist/5NUtKAP5hs5lykCkC0cW0E?si=0aefef20c2cf400f&pt=de30ee8ae7cc016cbf200d13379369c8",
                "--output-path",
                "/home/soulripper/debug/my_playlist"
            ]
        },
        {
            "name": "--download-liked",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--download-liked",
            ]
        },
        {
            "name": "--download-all-playlists",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--download-all-playlists",
            ]
        },
        {
            "name": "--drop-database",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--drop-database"
            ]
        },
        {
            "name": "--search-query",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--search-query",
                "Thotiana in desc] (full mashup) - The Marias - No one noticed, Blueface, full"
            ]
        },
        {
            "name": "--debug",
            "type": "debugpy",
            "request": "launch",
            "module": "soulripper.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--debug",
            ]
        },
    ]
}
